# Leave MONGO_URI empty in development to use a local auto-started MongoDB (data in server/.local-db)
MONGO_URI=
JWT_SECRET=change-me-to-a-long-random-string
# OAuth client ID from Google Cloud Console (APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
# Admins: exact addresses only, comma-separated. Workers are added by an admin in the app ("צוות").
ADMIN_EMAILS=
# Production port (dev always uses 4000)
PORT=4000
# Email to admins when a project is submitted (any SMTP server). Gmail: smtp.gmail.com, port 465,
# SMTP_USER = the Gmail address, SMTP_PASS = an App Password (Google account > Security > App passwords).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="תלם – ניהול פרויקטים <office@example.com>"
# Public address of the site, for links in emails (on Vercel defaults to the production domain)
APP_URL=
