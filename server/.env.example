# Leave MONGO_URI empty in development to use a local auto-started MongoDB (data in server/.local-db)
MONGO_URI=
JWT_SECRET=change-me-to-a-long-random-string
# OAuth client ID from Google Cloud Console (APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
# Optional: who may sign in. Comma-separated emails and/or domains, e.g. "a@gmail.com,@office.co.il".
# Empty = any Google account.
ALLOWED_EMAILS=
# Production port (dev always uses 4000)
PORT=4000
